# Copy to .env to override the defaults. Every variable is optional: the values below are the defaults.
# docker compose reads .env too; it always sets NODE_ENV, TRUST_PROXY and SMTP_HOST/PORT itself.
# Never commit .env: put real credentials (e.g. SMTP_PASSWORD) only there or in a secrets manager.

# --- API server ---
PORT=3000
# error | warn | info | debug
LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 behind nginx), so rate limits see the client's IP.
TRUST_PROXY=0
# Browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Product data ---
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# The business owner's "top rated" product IDs, in display order.
TOP_RATED_PRODUCT_IDS=12,11,3,18,5

# --- Email: Mailpit locally, any SMTP provider (e.g. AWS SES) in production ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=vitrine@example.com
SALES_INBOX_EMAIL=sales@example.com
# Base URL of the web app, used for the product link in enquiry emails.
WEB_BASE_URL=http://localhost:8080
